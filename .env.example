# Server-only GitHub token used by api/github-contributions.js.
# Create a fine-grained token with the minimum read-only metadata access needed.
# Never prefix this with VITE_ and never commit the real value.
GITHUB_TOKEN=
# Server-only Resend API key for the contact form.
RESEND_API_KEY=
# Use onboarding@resend.dev until a custom sending domain is verified.
RESEND_FROM_EMAIL=Abhinav Deshwal <onboarding@resend.dev>
